{
  "manifest_version": 3,
  "name": "Tab & Bookmark Panel",
  "version": "1.0.0",
  "description": "サイドパネルでタブとブックマークを管理",
  "permissions": [
    "sidePanel",
    "tabs",
    "bookmarks",
    "favicon",
    "storage"
  ],
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://x.com/*",
        "*://twitter.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "*://www.youtube.com/*"
      ],
      "js": [
        "content-youtube.js"
      ],
      "run_at": "document_start"
    }
  ]
}
