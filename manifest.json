{
  "manifest_version": 3,
  "name": "Tab & Bookmark Panel",
  "version": "1.9",
  "description": "サイドパネルでタブとブックマークを効率的に管理。",
  "permissions": [
    "sidePanel",
    "tabs",
    "bookmarks",
    "history",
    "favicon",
    "storage",
    "scripting",
    "activeTab",
    "declarativeNetRequest"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "options_page": "presenter/options.html",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*", "file:///*"],
      "js": ["presenter/core.js", "presenter/content.js"],
      "all_frames": true,
      "match_about_blank": true,
      "run_at": "document_idle"
    },
    {
      "matches": [
        "*://x.com/*",
        "*://twitter.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "*://www.youtube.com/*"
      ],
      "js": [
        "content-youtube.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "*://chatgpt.com/*",
        "*://claude.ai/*",
        "*://gemini.google.com/*",
        "*://copilot.microsoft.com/*",
        "*://m365.cloud.microsoft/*",
        "*://chat.deepseek.com/*",
        "*://grok.com/*",
        "*://www.perplexity.ai/*",
        "*://chat.mistral.ai/*",
        "*://notebooklm.google.com/*",
        "*://github.com/*",
        "*://poe.com/*",
        "*://v0.app/*",
        "*://cursor.com/*"
      ],
      "js": [
        "content-ai.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content-caret-mode.js"
      ],
      "all_frames": true,
      "run_at": "document_end"
    }
  ],
  "commands": {
    "toggleSpotlight": { "suggested_key": { "default": "Ctrl+Shift+S", "mac": "Command+Shift+S" }, "description": "スポットライト ON/OFF" },
    "togglePen": { "suggested_key": { "default": "Ctrl+Shift+P", "mac": "Command+Shift+P" }, "description": "手書きペン ON/OFF" },
    "toggleZoom": { "suggested_key": { "default": "Ctrl+Shift+M", "mac": "Command+Shift+M" }, "description": "ズーム ON/OFF" },
    "toggleLaser": { "description": "レーザーポインター ON/OFF" },
    "toggleAreaSpotlight": { "description": "エリアスポットライト ON/OFF" },
    "undoDrawing": { "description": "手書きを元に戻す" },
    "redoDrawing": { "description": "手書きをやり直す" },
    "clearDrawing": { "description": "手書きを全消去" },
    "allOff": { "description": "プレゼンカーソルをOFF" }
  }
}
